# RAG + Tool Calling Agent - Environment Variables
# Copy to .env and fill in your keys

# LLM Provider (dashscope, deepseek, openai, anthropic)
LLM_PROVIDER=dashscope

# Embedding 独立供应商（与 LLM_PROVIDER 解耦；DeepSeek 无 Embedding 接口，须用 dashscope/openai）
EMBEDDING_PROVIDER=dashscope

# 模型名不内置，按需填写（示例见 README「供应商配置示例」）
# Dashscope / Qwen（推荐用于 Embedding）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=
DASHSCOPE_EMBEDDING_MODEL=

# DeepSeek（仅对话，无 Embedding 接口，RAG 入库需另配 Embedding 供应商）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=

# OpenAI（Alternative）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=

# Anthropic（Alternative，仅对话）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_CHAT_MODEL=

# Security
# 未配置时服务拒绝启动；本地演示可用 local-demo，公网部署必须改为强随机 Token
# AUTH_DISABLED=true 显式关闭鉴权，仅用于本地开发或自动化测试
APP_API_TOKEN=local-demo
AUTH_DISABLED=false
CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001,http://localhost:8081,http://127.0.0.1:8081
MAX_UPLOAD_MB=50

# Session Cache
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# Rate Limiting (optional; Redis 不可用时使用进程内计数兜底)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60
RATE_LIMIT_TRUST_XFF=false

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval
TOP_K=5
SCORE_THRESHOLD=0.7
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3

# Embedding
EMBEDDING_MAX_BATCH=10
EMBEDDING_TIMEOUT=60
EMBEDDING_MAX_RETRIES=3

# Server
HOST=127.0.0.1
PORT=8081
LOG_LEVEL=INFO